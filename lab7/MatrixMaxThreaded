import java.util.Random;

public class MatrixMaxThreaded {


    static class MaxInRowThread extends Thread {
        private final int[] row;

        private int rowMax = Integer.MIN_VALUE;

        public MaxInRowThread(int[] row) {
            this.row = row;
        }

        @Override
        public void run() {
            for (int val : row) {
                if (val > rowMax) {
                    rowMax = val;
                }
            }
        }


        public int getRowMax() {
            return rowMax;
        }
    }

    public static void main(String[] args) {

        int rows = 5;
        int cols = 8;
        int[][] matrix = new int[rows][cols];
        Random random = new Random();

        System.out.println("Исходная матрица:");
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                matrix[i][j] = random.nextInt(1000); // Числа от 0 до 999
                System.out.printf("%4d ", matrix[i][j]);
            }
            System.out.println();
        }
        System.out.println();


        MaxInRowThread[] threads = new MaxInRowThread[rows];


        for (int i = 0; i < rows; i++) {
            threads[i] = new MaxInRowThread(matrix[i]);
            threads[i].start();
        }

        int globalMax = Integer.MIN_VALUE;


        try {
            for (int i = 0; i < rows; i++) {

                threads[i].join();


                int localMax = threads[i].getRowMax();
                System.out.println("Максимум в строке " + i + ": " + localMax);


                if (localMax > globalMax) {
                    globalMax = localMax;
                }
            }
        } catch (InterruptedException e) {
            System.err.println("Работа главного потока была прервана: " + e.getMessage());
        }


        System.out.println("\nГлобальный максимум матрицы: " + globalMax);
    }
}
